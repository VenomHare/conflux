{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "NEXT_PUBLIC_COLLAB_URL", "REDIS_URL", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PUBLIC_URL", "VERCEL_URL", "DEBUG_MODE"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "NEXT_PUBLIC_COLLAB_URL", "REDIS_URL", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PUBLIC_URL", "VERCEL_URL", "DEBUG_MODE"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "db:migrate:dev": {
      "dependsOn": ["generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:migrate:deploy": {
      "dependsOn": ["generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:push": {
      "dependsOn": ["generate"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^generate"],
      "env": ["DATABASE_URL", "SEED_DEMO_PASSWORD"],
      "cache": false
    },
    "db:seed:demo": {
      "dependsOn": ["^generate"],
      "env": ["DATABASE_URL", "SEED_DEMO_PASSWORD"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "NEXT_PUBLIC_COLLAB_URL", "REDIS_URL", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PUBLIC_URL", "VERCEL_URL", "DEBUG_MODE"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^generate"],
      "env": ["DATABASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PUBLIC_URL", "VERCEL_URL", "DEBUG_MODE", "API_BASE_URL"]
    },
    "test:api": {
      "dependsOn": ["^test:api"],
      "env": ["DATABASE_URL", "AUTH_SECRET", "API_BASE_URL"]
    }
  }
}
